# Copy to .env and fill in. Set at least one cloud key, or use LLM_PROVIDER=ollama (local only).

# --- AI provider -------------------------------------------------------------
# Primary engine at startup (switch live in the window header):
# gemini | claude | openai | grok | custom | ollama
LLM_PROVIDER=gemini
# Seconds before local Ollama starts racing a slow cloud call (first answer wins)
CLOUD_TIMEOUT=2.5

# Google Gemini (free tier: ~20 requests/day/model, too few for a meeting; enable billing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# minimal | low | medium | high | off
GEMINI_THINKING=minimal

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max | off  (low = fastest)
CLAUDE_EFFORT=low

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# xAI Grok
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Any OpenAI-compatible endpoint: OmniRoute, OpenRouter, LiteLLM, LM Studio, vLLM ...
# CUSTOM_LABEL=OmniRoute
# CUSTOM_BASE_URL=http://localhost:20128/v1
# CUSTOM_MODEL=gh/gpt-5.1-codex
CUSTOM_LABEL=Custom
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Local fallback (always used when the cloud is slow, offline or out of quota).
# Any installed Ollama chat model works; all of them can also be picked in the window.
OLLAMA_MODEL=granite4:7b-a1b-h

# --- Assistant ---------------------------------------------------------------
# Proactive pacing: react after the participant paused this long (s), during a monologue at the
# latest after PROACTIVE_MAX_WAIT; a new card replaces the one on screen after SUGGESTION_READ_S.
PROACTIVE_PAUSE=1.5
PROACTIVE_MAX_WAIT=15
SUGGESTION_READ_S=10
# One suggestion per card instead of two, in a larger font
SINGLE_SUGGESTION=false
# Role: system (client/sales calls) | interview (job interviews, meetings at work)
PROMPT=system
# Extra knowledge files or folders to index, separated by ";" (.md and .json)
# KB_EXTRA_PATHS=C:/Users/me/Notes/Interview Prep.md;C:/Users/me/Notes/Company
KB_EXTRA_PATHS=
# Seconds between rolling meeting-memory updates
MEMORY_INTERVAL=300

# --- Audio / speech ------------------------------------------------------------
# Device name substrings (see: uv run python -m copilot.devices); empty = system default
# (macOS: LOOPBACK_DEVICE defaults to BlackHole)
MIC_DEVICE=
LOOPBACK_DEVICE=
# auto = large-v3-turbo/float16 on an NVIDIA GPU, small/int8 on the CPU.
# Too slow on your CPU? WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_MODEL=auto
WHISPER_COMPUTE=auto
# auto (one of LANGUAGES, sticky per speaker) | a fixed language code, e.g. de (skips detection)
WHISPER_LANGUAGE=auto
# Spoken languages, yours first (translation goes into it). Any Whisper language code works.
LANGUAGES=de,en
# Force the language of the suggestions, e.g. en (empty = as the prompt says: German, or the interviewer's)
REPLY_LANGUAGE=
# Embedding model for your notes; for languages other than German/English use a multilingual one
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
