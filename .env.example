# Copy to .env and fill in. Everything except GEMINI_API_KEY is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# minimal | low | medium | high | off
GEMINI_THINKING=minimal
# Seconds before Ollama is started in parallel with a slow Gemini call
GEMINI_TIMEOUT=2.5
OLLAMA_MODEL=granite4:7b-a1b-h

# Assistant role: system (client/sales calls) | interview (job interviews, meetings at work)
PROMPT=system
# Extra knowledge files or folders to index, separated by ";" (.md and .json)
# KB_EXTRA_PATHS=C:/Users/me/Notes/Interview Prep.md;C:/Users/me/Notes/Company
KB_EXTRA_PATHS=
# Seconds between rolling meeting-memory updates
MEMORY_INTERVAL=300

# Device name substrings (see: uv run python -m copilot.devices); empty = Windows default
MIC_DEVICE=
LOOPBACK_DEVICE=
# auto (German/English, sticky per speaker) | de | en
WHISPER_LANGUAGE=auto
